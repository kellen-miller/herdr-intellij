{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./gradlew clean buildPlugin -PpluginVersion=${nextRelease.version} && sha256sum build/distributions/*.zip > build/distributions/SHA256SUMS"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/distributions/*.zip",
            "label": "Herdr for JetBrains ${nextRelease.version}"
          },
          {
            "path": "build/distributions/SHA256SUMS",
            "label": "SHA-256 checksums"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
